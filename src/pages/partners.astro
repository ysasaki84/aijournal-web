---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';

const usesEndpoint = Boolean(SITE.contactFormEndpoint);
const topics = ['番組スポンサー', 'タイアップ・共同コンテンツ', '公開収録・イベント', '共創・その他'];
---

<Base
  title="スポンサー募集｜日本AIジャーナル ウェブ版"
  description="日本AIジャーナルのスポンサー・タイアップ・公開収録・共同企画のご相談窓口です。"
  ogImage="/still-session.jpg"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="page-kicker">スポンサー募集</p>
      <h1 class="page-title">AI導入を決める人に、<br />届く番組です。</h1>
      <p class="page-lede">
        日本AIジャーナルの視聴者・読者は、AIの導入を判断する経営層や部門責任者、現場で運用を担う担当者です。番組と一緒に、意思決定層との接点をつくりませんか。
      </p>
      <a class="btn btn-light" href="#contact">相談する</a>
    </div>
    <figure class="page-still">
      <img src="/still-session.jpg" alt="ゲストを招いた番組の収録風景" width="1280" height="720" />
    </figure>
  </section>

  <section class="page-section">
    <div class="container">
      <h2 class="section-title">ご一緒できること</h2>
      <div class="offers">
        <div class="offer">
          <h3>意思決定層への直接リーチ</h3>
          <p>大企業のAI導入・活用の意思決定層、中小企業の社長・役員層が、導入判断の材料として番組と記事を見ています。</p>
        </div>
        <div class="offer">
          <h3>タイアップ・共同コンテンツ</h3>
          <p>出演や共同企画を通じて、貴社の取り組みを報道の視点とあわせて伝えます。</p>
        </div>
        <div class="offer">
          <h3>公開収録・イベント</h3>
          <p>公開収録やイベントで、法人の意思決定者と直接対話する場を設計します。収録内容は記事・動画・音声で再利用できます。</p>
        </div>
        <div class="offer">
          <h3>共創・新しい連携</h3>
          <p>広告や研修の枠を超えて、共同実証やコンソーシアムなど、まだ形になっていない連携を一緒に設計します。</p>
        </div>
      </div>
      <p class="note">
        編集の独立性について：スポンサー企画は通常の取材記事と区別して明示し、編集方針は番組側で管理します。
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container split">
      <h2 class="split-title">ご相談の流れ</h2>
      <ol class="steps">
        <li>
          <h3>お問い合わせ</h3>
          <p>下のフォームから、ご関心の内容をお送りください。</p>
        </li>
        <li>
          <h3>ヒアリング</h3>
          <p>目的・時期・ご予算感をオンラインで伺います。</p>
        </li>
        <li>
          <h3>企画のご提案</h3>
          <p>出演、記事、公開収録などの組み合わせをご提案します。</p>
        </li>
        <li>
          <h3>収録・公開</h3>
          <p>収録後、動画・音声・記事として公開します。</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="page-section page-section-last" id="contact" aria-labelledby="contact-title">
    <div class="container split">
      <div>
        <h2 class="split-title" id="contact-title">お問い合わせ</h2>
        <p class="contact-aside">
          メールで直接ご連絡いただくこともできます。<br />
          <a class="text-link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
      </div>

      <form
        class="contact-form"
        id="contact-form"
        method="post"
        action={usesEndpoint ? SITE.contactFormEndpoint : undefined}
        data-mailto={usesEndpoint ? undefined : SITE.contactEmail}
      >
        <div class="field-row">
          <div class="field">
            <label for="cf-company">会社名</label>
            <input id="cf-company" name="company" autocomplete="organization" required />
          </div>
          <div class="field">
            <label for="cf-name">お名前</label>
            <input id="cf-name" name="name" autocomplete="name" required />
          </div>
        </div>
        <div class="field">
          <label for="cf-email">メールアドレス</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <fieldset class="field">
          <legend>ご関心の内容</legend>
          <div class="chips">
            {
              topics.map((t, i) => (
                <label class="chip">
                  <input type="radio" name="topic" value={t} checked={i === 0} />
                  <span>{t}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field">
          <label for="cf-message">ご相談内容</label>
          <textarea
            id="cf-message"
            name="message"
            rows="6"
            placeholder="時期、ご予算感、ご検討中の企画などがあればご記入ください。"></textarea>
        </div>
        <div class="form-actions">
          <button class="btn btn-light" type="submit">{usesEndpoint ? '送信する' : 'メールを作成する'}</button>
          <p class="form-note">
            {
              usesEndpoint
                ? '内容を確認のうえ、担当者からご連絡します。'
                : 'お使いのメールアプリが開き、入力内容が本文に入ります。そのまま送信してください。'
            }
          </p>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  // 送信先サービス未設定のときは、入力内容入りのメールを作成する
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const to = form?.dataset.mailto;
  if (form && to) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const v = (k: string) => String(data.get(k) ?? '').trim();
      const subject = `【スポンサー相談】${v('company')} ${v('name')}様`;
      const body = [
        `会社名：${v('company')}`,
        `お名前：${v('name')}`,
        `メールアドレス：${v('email')}`,
        `ご関心の内容：${v('topic')}`,
        '',
        v('message'),
      ].join('\n');
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const status = form.querySelector('.form-status');
      if (status) status.textContent = `メールアプリを開きました。送信を完了してください。開かない場合は ${to} 宛てに直接お送りください。`;
    });
  }
</script>
