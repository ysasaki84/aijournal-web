---
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { SITE } from '../site.config';
import {
  getEpisodes,
  pickFeatured,
  readingMinutes,
  guestName,
  formatDate,
  isoDate,
  thumb,
} from '../lib/episodes';

const episodes = await getEpisodes();
const featured = pickFeatured(episodes);
const rest = episodes.filter((e) => e !== featured);
const latest = episodes[0];
const categories = [...new Set(episodes.map((e) => e.data.category).filter(Boolean))] as string[];
---

<Base overlayHeader>
  {/* ファーストビュー：番組映像 */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/hero-poster.jpg"
        data-poster-mobile="/hero-mobile-poster.jpg"
      >
        {/* モバイル（縦画面）は専用の縦動画。横動画の左右見切れを防ぐ */}
        <source src="/hero-mobile.mp4" type="video/mp4" media="(max-width: 640px)" />
        <source src="/hero-loop.mp4" type="video/mp4" />
      </video>
      <div class="hero-grade"></div>
    </div>

    <div class="container hero-body">
      <p class="hero-kicker">AI業界の当事者に聞く、取材番組</p>
      <h1 class="hero-title" id="hero-title">
        <span class="hero-line"><span><span class="hero-phrase">AIを入れる前も、</span><span class="hero-phrase">つまずいたあとも。</span></span></span>
        <span class="hero-line"><span class="hero-phrase">現場の実話を聞こう。</span></span>
      </h1>
      <p class="hero-lede">
        経営者・研究者・開発の当事者に深く聞く「日本AIジャーナル」。番組の対話を、導入判断に使える記事にして公開しています。
      </p>
      <div class="hero-actions">
        <a href="#articles" class="btn btn-light">記事を読む</a>
        <a href={`${SITE.channelUrl}?sub_confirmation=1`} class="btn btn-line">YouTubeで番組を見る</a>
      </div>
    </div>

    <div class="container hero-foot">
      {
        latest && (
          <a class="hero-latest" href={`/episodes/${latest.id}/`}>
            <span class="live-dot" aria-hidden="true" />
            <span class="hero-latest-label">最新回</span>
            <span class="hero-latest-title">{latest.data.title}</span>
          </a>
        )
      }
      <button class="hero-toggle" type="button" aria-pressed="false" aria-label="背景の映像を一時停止">
        <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2v10h-2zM9.5 3h2v10h-2z" /></svg>
        <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" /></svg>
      </button>
    </div>
  </section>

  {/* 記事一覧 */}
  <section class="articles" id="articles" aria-labelledby="articles-title">
    <div class="container">
      <header class="articles-head">
        <div>
          <h2 class="section-title" id="articles-title">記事</h2>
          <p class="section-note">番組の対話を、要点と全文で読める記事にしています。</p>
        </div>
        {
          categories.length > 1 && (
            <div class="filter" role="group" aria-label="テーマで絞り込む">
              <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
                すべて
              </button>
              {categories.map((c) => (
                <button type="button" class="filter-btn" data-filter={c} aria-pressed="false">
                  {c}
                </button>
              ))}
            </div>
          )
        }
      </header>

      {
        featured && (
          <article class="feature" data-category={featured.data.category}>
            <a class="feature-media" href={`/episodes/${featured.id}/`} tabindex="-1" aria-hidden="true">
              <img
                src={thumb(featured.data.youtubeId)}
                data-fallback={thumb(featured.data.youtubeId, 'hqdefault')}
                alt=""
                width="1280"
                height="720"
                decoding="async"
              />
            </a>
            <div class="feature-body">
              <div class="meta">
                {featured.data.category && <span class="meta-cat">{featured.data.category}</span>}
                <time datetime={isoDate(featured.data.publishedAt)}>{formatDate(featured.data.publishedAt)}</time>
                <span>{readingMinutes(featured)}分で読める</span>
              </div>
              <h3 class="feature-title">
                <a href={`/episodes/${featured.id}/`}>{featured.data.title}</a>
              </h3>
              {featured.data.guest && <p class="feature-guest">ゲスト　{guestName(featured.data.guest)}</p>}
              {featured.data.points.length > 0 ? (
                <div class="feature-points">
                  <p class="feature-points-head">この回でわかること</p>
                  <ul>
                    {featured.data.points.slice(0, 3).map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </div>
              ) : (
                <p class="feature-summary">{featured.data.summary}</p>
              )}
              <a class="btn btn-light" href={`/episodes/${featured.id}/`}>
                記事を読む
              </a>
            </div>
          </article>
        )
      }

      {
        rest.length > 0 && (
          <ul class="card-grid">
            {rest.map((episode) => (
              <li data-category={episode.data.category}>
                <EpisodeCard episode={episode} />
              </li>
            ))}
          </ul>
        )
      }

      {episodes.length === 0 && <p class="empty">最初の記事を準備しています。番組はYouTubeで公開中です。</p>}
    </div>
  </section>

  {/* 番組について（要約） */}
  <section class="home-about" aria-labelledby="home-about-title">
    <div class="container home-about-inner">
      <h2 class="statement" id="home-about-title">当事者に、<br />深く聞く。</h2>
      <div class="home-about-text">
        <p>
          日本AIジャーナルは、日本経済新聞社の北爪がMCを務め、AI業界の経営者・研究者・開発者・導入企業を招いて話を聞く番組です。<a class="text-link" href={SITE.channelUrl}>YouTube</a>と<a class="text-link" href={SITE.podcastUrl}>Podcast</a>で毎週配信しています。
        </p>
        <p>
          ニュースでは拾われない現場の一次情報を、比較表や検証データ、実践の手順まで残して記事にしています。
        </p>
        <a class="text-link" href="/about/">番組について詳しく</a>
      </div>
    </div>
  </section>

  {/* スポンサー向け */}
  <section class="home-partner" aria-labelledby="home-partner-title">
    <div class="container">
      <div class="partner-band">
        <div>
          <h2 class="partner-band-title" id="home-partner-title">番組と一緒に、企画をつくりませんか。</h2>
          <p>
            AI導入を判断する経営層・責任者に向けて、タイアップや公開収録、共同企画を設計できます。スポンサー・協業のご相談を受け付けています。
          </p>
        </div>
        <a class="btn btn-light" href="/partners/">スポンサーについて見る</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // 背景映像の再生／一時停止（視覚的な動きを減らす設定の場合は最初から停止）
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-toggle');

  // モバイル（縦画面）では縦動画・縦ポスターを確実に使う。
  // <source media> を解釈しないブラウザでも正しい動画に差し替える保険。
  if (video) {
    const isMobile = window.matchMedia('(max-width: 640px)').matches;
    const mobilePoster = video.dataset.posterMobile;
    if (isMobile) {
      if (mobilePoster) video.poster = mobilePoster;
      const sources = Array.from(video.querySelectorAll<HTMLSourceElement>('source'));
      const mobileSrc = sources.find((s) => s.hasAttribute('media'))?.getAttribute('src');
      if (mobileSrc) {
        const current = (video.currentSrc || '').split('/').pop();
        if (current !== mobileSrc.split('/').pop()) {
          video.src = mobileSrc;
          video.load();
          video.play().catch(() => {});
        }
      }
    }
  }
  if (video && toggle) {
    const setPaused = (paused: boolean) => {
      if (paused) video.pause();
      else video.play().catch(() => {});
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? '背景の映像を再生' : '背景の映像を一時停止');
    };
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) setPaused(true);
    toggle.addEventListener('click', () => setPaused(!video.paused));
  }

  // テーマで絞り込み
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.articles [data-category]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const value = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((item) => {
        item.hidden = !(value === 'all' || item.dataset.category === value);
      });
    }),
  );
</script>
