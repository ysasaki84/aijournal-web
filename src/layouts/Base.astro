---
import '../styles/global.css';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** 動画ヒーローの上に透明なヘッダーを重ねる（トップページ用） */
  overlayHeader?: boolean;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  overlayHeader = false,
  ogImage = '/hero-poster.jpg',
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/#articles', label: '記事', current: path.startsWith('/episodes') },
  { href: '/about/', label: '番組について', current: path.startsWith('/about') },
  { href: '/partners/', label: 'スポンサー募集', current: path.startsWith('/partners') },
];
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F19" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header" data-overlay={overlayHeader ? '' : undefined}>
      <div class="container header-inner">
        <a href="/" class="brand">
          <img src="/logo-mark.png" alt="" width="36" height="36" />
          <span class="brand-name">日本AIジャーナル</span>
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="menu-toggle-bars" aria-hidden="true"></span>
          <span class="menu-toggle-label">メニュー</span>
        </button>

        <nav class="site-nav" id="site-nav" aria-label="メインメニュー">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn btn-line btn-sm" href={SITE.channelUrl}>YouTubeチャンネル</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand">
            <img src="/logo-mark.png" alt="" width="36" height="36" />
            <span class="brand-name">日本AIジャーナル</span>
          </a>
          <p>AI業界の当事者に深く聞く、取材メディア。</p>
        </div>
        <ul class="footer-nav">
          <li><a href="/#articles">記事一覧</a></li>
          <li><a href="/about/">番組について</a></li>
          <li><a href="/partners/">スポンサー募集</a></li>
          <li><a href={SITE.channelUrl}>YouTubeチャンネル</a></li>
          <li><a href={SITE.podcastUrl}>Podcast</a></li>
        </ul>
      </div>
      <div class="container footer-legal">
        <small>© 2026 日本AIジャーナル</small>
      </div>
    </footer>

    <script>
      // ヘッダー：動画の上では透明、スクロールしたら背景を敷く
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header?.hasAttribute('data-overlay')) {
        const update = () => header.classList.toggle('is-solid', window.scrollY > 24);
        update();
        window.addEventListener('scroll', update, { passive: true });
      }

      // モバイルメニュー
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        header?.classList.toggle('is-open', open);
      });
      document.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach((a) =>
        a.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          header?.classList.remove('is-open');
        }),
      );

      // YouTubeサムネイル：高解像度版が無い動画（120px幅のダミー画像が返る）は標準画質に差し替え
      document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach((img) => {
        const swap = () => {
          const fallback = img.dataset.fallback;
          if (fallback) {
            img.removeAttribute('data-fallback');
            img.src = fallback;
          }
        };
        const check = () => {
          if (img.naturalWidth > 0 && img.naturalWidth <= 120) swap();
        };
        if (img.complete) check();
        else {
          img.addEventListener('load', check, { once: true });
          img.addEventListener('error', swap, { once: true });
        }
      });
    </script>
  </body>
</html>
