---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = '日本AIジャーナル ウェブ版' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Oswald:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-title">
          <img src="/logo-mark.png" alt="日本AIジャーナル" width="32" height="32" />
          日本AIジャーナル <span>ウェブ版</span>
        </a>
        <nav class="nav-links">
          <a href="https://www.youtube.com/@nipponaijournal" class="nav-link">YouTube</a>
          <a href="https://www.youtube.com/@nipponaijournal" class="btn-primary">チャンネル登録</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container" style="text-align: center;">
        <img src="/logo-banner.jpg" alt="日本AIジャーナル" width="354" height="48" style="border-radius: 8px; margin-bottom: 16px;" />
        <p>© 2026 日本AIジャーナル — YouTubeの取材対話を、繰り返し参照できる文章資産に。</p>
      </div>
    </footer>
  </body>
</html>
